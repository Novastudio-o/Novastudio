    h1 { font-size:48px; letter-spacing:2px; }
    p.lead { font-size:18px; max-width:700px; margin:auto; color:#aaa; }
    .btn { display:inline-block; background:#fff; color:#000; padding:10px 25px; margin-top:20px; text-decoration:none; font-weight:bold; border-radius:5px; }
    section { padding:60px 20px; max-width:1000px; margin:auto; }
    h2 { font-size:28px; text-align:center; margin-bottom:40px; border-bottom:2px solid #fff; display:inline-block; padding-bottom:10px; }
